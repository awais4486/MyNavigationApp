require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.6'

use_frameworks! :linkage => :static

prepare_react_native_project!

# Firebase configuration
$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true

# Use React Native's source core instead of prebuilt RN core
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

pod 'GoogleUtilities', :modular_headers => true

target 'MyNavigationApp' do

  config = use_native_modules!
  pod 'SDWebImage', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
  react_native_post_install(installer)

  installer.pods_project.targets.each do |target|
  target.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.6'
    config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited)'
    config.build_settings['HEADER_SEARCH_PATHS'] << ' "$(PODS_ROOT)/../../node_modules/react-native/ReactCommon"'

    # Apple Silicon simulator
    config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
    config.build_settings['ARCHS[sdk=iphonesimulator*]'] = 'arm64'

    # FirebaseCore must expose a module for FirebaseMessaging
    if target.name == 'FirebaseCore'
      config.build_settings['DEFINES_MODULE'] = 'YES'
    end
  end
end

  # Remove the arm64 simulator exclusion generated by CocoaPods
  pods_xcconfig_dir = File.join(
    installer.sandbox.root.to_s,
    'Target Support Files',
    'Pods-MyNavigationApp'
  )

  Dir.glob(File.join(pods_xcconfig_dir, '*.xcconfig')).each do |file|
    contents = File.read(file)

    contents = contents.gsub(
      /^EXCLUDED_ARCHS\[sdk=iphonesimulator\*\] = arm64\n?/,
      ''
    )

    File.write(file, contents)
  end
end

end
